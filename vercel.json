{
  "version": 2,
  "rewrites": [
    {
      "source": "/quik/:path*",
      "destination": "https://hydration-cycle-answering.ngrok-free.dev/quik/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/quik/:path*",
      "headers": [
        { "key": "ngrok-skip-browser-warning", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, ngrok-skip-browser-warning, Authorization" }
      ]
    }
  ]
}
